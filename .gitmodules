[submodule "lib/cmsis-core"]
	path = lib/cmsis-core
	url = https://github.com/STMicroelectronics/cmsis-core.git
[submodule "lib/cmsis-device-l0"]
	path = lib/cmsis-device-l0
	url = https://github.com/STMicroelectronics/cmsis-device-l0.git
[submodule "lib/stm32l0xx-hal-driver"]
	path = lib/stm32l0xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32l0xx-hal-driver.git
[submodule "lib/tinyusb"]
	path = lib/tinyusb
	url = https://github.com/hathach/tinyusb.git
